{
  "name": "location-share",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Consent-based, one-time location sharing",
  "scripts": {
    "dev": "node scripts/local-server.js",
    "check": "node --check src/worker.js && node --check src/api.js && node --check src/session.js && node --check src/capabilities.js && node --check public/app.js && node --check public/maps.js && node scripts/headers.js --check && node scripts/vendor.js --check",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "build": "wrangler deploy --env='' --dry-run --outdir .build",
    "deploy": "wrangler deploy --env=''",
    "headers:sync": "node scripts/headers.js",
    "vendor:sync": "node scripts/vendor.js",
    "signing:setup": "node scripts/setup-signing.js",
    "prebuild": "npm run check",
    "predeploy": "npm run check"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0",
    "wrangler": "4.149.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@maplibre/maplibre-gl-leaflet": "0.1.4",
    "leaflet": "1.9.4",
    "maplibre-gl": "6.14.0",
    "qrcode-generator": "2.0.4"
  }
}

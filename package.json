{
  "name": "location-share",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Consent-based, one-time location sharing",
  "scripts": {
    "dev": "wrangler dev --env local --ip 127.0.0.1 --port 8787",
    "check": "node --check src/worker.js && node --check src/session.js && node --check public/app.js",
    "test": "node --test tests/session.test.js",
    "test:browser": "playwright test",
    "build": "wrangler deploy --env='' --dry-run --outdir .build",
    "deploy": "wrangler deploy --env=''",
    "admin:setup": "node scripts/setup-admin.js"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "wrangler": "4.149.0"
  },
  "engines": { "node": ">=22.12" }
}
